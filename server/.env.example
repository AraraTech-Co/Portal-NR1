PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portal_nr1?schema=public
CLIENT_ORIGIN=http://localhost:5173
TOKEN_SECRET=change-me-to-a-long-random-string

# Proxies que podem informar o IP real (X-Forwarded-For): número de saltos
# ("1") ou endereços e faixas ("10.0.0.1, 172.16.0.0/12", "loopback").
# Vazio = nenhum, e o limite de tentativas por IP fica desligado. "true" é
# recusado. Em produção, atrás do proxy, configure com os saltos reais.
TRUST_PROXY=
