{
  "name": "portal-nr1",
  "private": true,
  "version": "0.1.0",
  "description": "Portal NR-1 — React + Express (scaffold)",
  "scripts": {
    "setup": "npm install && npm run setup:server && npm run setup:client",
    "setup:server": "cd server && npm install",
    "setup:client": "cd client && npm install",
    "server": "cd server && npm run server",
    "client": "cd client && npm run dev",
    "local:dev": "concurrently --names \"server,client\" -c \"green.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "typescript": "^5.9.3"
  }
}
