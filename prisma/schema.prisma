generator client {
  provider = "prisma-client-js"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papel na conta (acesso / responsabilidade).
/// OWNER = responsável pela conta, acesso total nela.
enum AccountRole {
  OWNER
  ADMIN
  USER
}

/// MASTER = papel na *empresa* (Organization): acima de OWNER, controla todas as contas.
/// Demais = papel operacional (SST/RH) na organização.
enum Role {
  MASTER
  ADMIN
  SST
  RH
  COLABORADOR
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  login              String   @unique @db.VarChar(64)
  email              String?  @unique @db.VarChar(256)
  name               String   @db.VarChar(256)
  passwordHash       String   @map("password_hash")
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  accountMemberships AccountMembership[]
  tokens             Token[]

  @@map("user")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(256)
  taxId     String?  @map("tax_id") @db.VarChar(18)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  accounts    Account[]

  @@map("organization")
}

/// Conta de acesso sob uma Organization.
/// Invariante de aplicação: toda Account ativa tem ≥1 OWNER.
model Account {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(256)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  AccountMembership[]

  @@index([organizationId])
  @@map("account")
}

/// Vínculo usuário ↔ conta. OWNER é o responsável (acesso total na conta).
model AccountMembership {
  id        String      @id @default(uuid()) @db.Uuid
  accountId String      @map("account_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      AccountRole @default(USER)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([accountId, role])
  @@index([userId])
  @@map("account_membership")
}

/// Papel operacional do usuário na organização (SST, RH, …).
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           Role     @default(COLABORADOR)
  grants         String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("membership")
}

model Token {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("token")
}
